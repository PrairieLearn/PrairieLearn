<?xml version="1.0" encoding="UTF-8"?>
<questestinterop xmlns="http://www.imsglobal.org/xsd/ims_qtiasiv1p2">
  <assessment ident="feedback-fill-in-blanks" title="Fill-in-the-blanks feedback">
    <section ident="root_section">
      <item ident="fill-in-blanks" title="Capital cities">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>fill_in_multiple_blanks_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>2.0</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Complete both capital cities.&lt;/p&gt;&lt;p&gt;Colombia: [capital1]. Estonia: [capital2].&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response_capital1" rcardinality="Single">
            <material>
              <mattext texttype="text/plain">capital1</mattext>
            </material>
            <render_choice>
              <response_label ident="answer_bogota">
                <material>
                  <mattext texttype="text/plain">bogota</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
          <response_lid ident="response_capital2" rcardinality="Single">
            <material>
              <mattext texttype="text/plain">capital2</mattext>
            </material>
            <render_choice>
              <response_label ident="answer_tallinn">
                <material>
                  <mattext texttype="text/plain">tallinn</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal" />
          </outcomes>
          <respcondition continue="Yes">
            <conditionvar>
              <varequal respident="response_capital1">answer_bogota</varequal>
            </conditionvar>
            <setvar action="Add" varname="SCORE">50</setvar>
            <displayfeedback feedbacktype="Response" linkrefid="answer_bogota_fb" />
          </respcondition>
          <respcondition continue="Yes">
            <conditionvar>
              <varequal respident="response_capital2">answer_tallinn</varequal>
            </conditionvar>
            <setvar action="Add" varname="SCORE">50</setvar>
            <displayfeedback feedbacktype="Response" linkrefid="answer_tallinn_fb" />
          </respcondition>
        </resprocessing>
        <itemfeedback ident="answer_bogota_fb">
          <flow_mat>
            <material>
              <mattext texttype="text/html">&lt;p&gt;Bogotá is Colombia's capital.&lt;/p&gt;</mattext>
            </material>
          </flow_mat>
        </itemfeedback>
        <itemfeedback ident="answer_tallinn_fb">
          <flow_mat>
            <material>
              <mattext texttype="text/html">&lt;p&gt;Tallinn is Estonia's capital.&lt;/p&gt;</mattext>
            </material>
          </flow_mat>
        </itemfeedback>
      </item>
    </section>
  </assessment>
</questestinterop>
