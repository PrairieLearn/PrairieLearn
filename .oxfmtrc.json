{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 100,
  "sortImports": {
    "groups": ["side_effect", "builtin", "external", "internal", "parent", "sibling", "index"],
    "internalPattern": ["@prairielearn/"],
    "newlinesBetween": true,
    "ignoreCase": false,
    "partitionByComment": true
  },
  "overrides": [
    {
      "files": ["*.jsonc"],
      "options": {
        "trailingComma": "none"
      }
    }
  ]
}
