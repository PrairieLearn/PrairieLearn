columns
    base_url: text not null
    course_instance_id: bigint not null
    created_at: timestamp with time zone not null default CURRENT_TIMESTAMP
    created_by: bigint not null
    encrypted_secret_key: text not null
    id: bigint not null default nextval('course_instance_ai_grading_custom_endpoints_id_seq'::regclass)
    name: text not null

indexes
    course_instance_ai_grading_custom_endpoints_pkey: PRIMARY KEY (id) USING btree (id)
    course_instance_ai_grading_custom_endpoints_ci_id_name_key: UNIQUE (course_instance_id, name) USING btree (course_instance_id, name)
    course_instance_ai_grading_custom_endpoints_ci_id_idx: USING btree (course_instance_id)

check constraints
    course_instance_ai_grading_custom_endpoints_name_length: CHECK (char_length(name) >= 1 AND char_length(name) <= 100)

foreign-key constraints
    course_instance_ai_grading_custom_endpo_course_instance_id_fkey: FOREIGN KEY (course_instance_id) REFERENCES course_instances(id) ON UPDATE CASCADE ON DELETE CASCADE
    course_instance_ai_grading_custom_endpoints_created_by_fkey: FOREIGN KEY (created_by) REFERENCES users(id) ON UPDATE CASCADE ON DELETE CASCADE
