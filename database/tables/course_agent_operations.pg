columns
    admitted_at: timestamp with time zone not null default now()
    conversation_id: bigint not null
    created_at: timestamp with time zone not null default now()
    dispatch_id: uuid not null default gen_random_uuid()
    finished_at: timestamp with time zone
    id: bigint not null default nextval('course_agent_operations_id_seq'::regclass)
    operation_id: uuid not null
    operation_number: integer not null
    payload: jsonb not null
    status: text not null default 'admitted'::text

indexes
    course_agent_operations_pkey: PRIMARY KEY (id) USING btree (id)
    course_agent_operations_conversation_id_operation_id_key: UNIQUE (conversation_id, operation_id) USING btree (conversation_id, operation_id)

check constraints
    course_agent_operations_status_check: CHECK (status = ANY (ARRAY['admitted'::text, 'running'::text, 'completed'::text, 'cancelled'::text, 'failed'::text, 'interrupted'::text, 'rejected'::text]))

foreign-key constraints
    course_agent_operations_conversation_id_fkey: FOREIGN KEY (conversation_id) REFERENCES course_agent_conversations(id) ON UPDATE CASCADE ON DELETE CASCADE
