columns
    course_id: bigint not null
    default_approval_mode: enum_course_agent_approval_mode not null default 'approval_required'::enum_course_agent_approval_mode
    user_id: bigint not null

indexes
    course_agent_user_settings_pkey: PRIMARY KEY (user_id, course_id) USING btree (user_id, course_id)
    course_agent_user_settings_course_id_idx: USING btree (course_id)

foreign-key constraints
    course_agent_user_settings_course_id_fkey: FOREIGN KEY (course_id) REFERENCES courses(id) ON UPDATE CASCADE ON DELETE CASCADE
    course_agent_user_settings_user_id_fkey: FOREIGN KEY (user_id) REFERENCES users(id) ON UPDATE CASCADE ON DELETE CASCADE
