columns
    assessment_id: bigint
    commit_hash: text
    course_id: bigint not null
    course_instance_id: bigint
    created_at: timestamp with time zone
    deleted: boolean not null default false
    id: bigint not null default nextval('chunks_id_seq'::regclass)
    question_id: bigint
    size_compressed: bigint
    size_uncompressed: bigint
    type: enum_chunk_type not null
    uuid: uuid

indexes
    chunks_pkey: PRIMARY KEY (id) USING btree (id)
    chunks_uuid_key: UNIQUE (uuid) USING btree (uuid)
    chunks_course_created_at_idx: USING btree (course_id, created_at DESC NULLS LAST)
    chunks_latest_revision_idx: USING btree (course_id, type, COALESCE(question_id, '-1'::integer::bigint), COALESCE(course_instance_id, '-1'::integer::bigint), COALESCE(assessment_id, '-1'::integer::bigint), created_at DESC NULLS LAST, id DESC)

check constraints
    chunks_uuid_deleted_check: CHECK (deleted = (uuid IS NULL))

foreign-key constraints
    chunks_assessment_id_fkey: FOREIGN KEY (assessment_id) REFERENCES assessments(id) ON UPDATE CASCADE ON DELETE CASCADE
    chunks_course_id_fkey: FOREIGN KEY (course_id) REFERENCES courses(id) ON UPDATE CASCADE ON DELETE CASCADE
    chunks_course_instance_id_fkey: FOREIGN KEY (course_instance_id) REFERENCES course_instances(id) ON UPDATE CASCADE ON DELETE CASCADE
    chunks_question_id_fkey: FOREIGN KEY (question_id) REFERENCES questions(id) ON UPDATE CASCADE ON DELETE CASCADE
