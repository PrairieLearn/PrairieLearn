columns
    cheating_reports_enabled: boolean not null default false
    end_date: timestamp with time zone
    id: bigint not null default nextval('pt_centers_id_seq'::regclass)
    name: text not null default ''::text
    term: text not null default 'Unknown'::text

indexes
    pt_centers_pkey: PRIMARY KEY (id) USING btree (id)

referenced by
    pt_center_courses: FOREIGN KEY (center_id) REFERENCES pt_centers(id) ON UPDATE CASCADE ON DELETE CASCADE
    pt_locations: FOREIGN KEY (center_id) REFERENCES pt_centers(id) ON UPDATE CASCADE ON DELETE CASCADE
