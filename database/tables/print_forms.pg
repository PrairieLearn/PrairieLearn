columns
    archived_at: timestamp with time zone
    assessment_id: bigint not null
    authn_user_id: bigint not null
    created_at: timestamp with time zone not null default CURRENT_TIMESTAMP
    id: bigint not null default nextval('print_forms_id_seq'::regclass)
    label: text not null
    user_id: bigint not null

indexes
    print_forms_pkey: PRIMARY KEY (id) USING btree (id)
    print_forms_assessment_id_label_key: UNIQUE (assessment_id, label) USING btree (assessment_id, label)
    print_forms_authn_user_id_idx: USING btree (authn_user_id)
    print_forms_user_id_idx: USING btree (user_id)

check constraints
    print_forms_label_check: CHECK (label ~ '^[A-Z]+$'::text)

foreign-key constraints
    print_forms_assessment_id_fkey: FOREIGN KEY (assessment_id) REFERENCES assessments(id) ON UPDATE CASCADE ON DELETE CASCADE
    print_forms_authn_user_id_fkey: FOREIGN KEY (authn_user_id) REFERENCES users(id) ON UPDATE CASCADE ON DELETE CASCADE
    print_forms_user_id_fkey: FOREIGN KEY (user_id) REFERENCES users(id) ON UPDATE CASCADE ON DELETE CASCADE

referenced by
    print_form_questions: FOREIGN KEY (print_form_id) REFERENCES print_forms(id) ON UPDATE CASCADE ON DELETE CASCADE
