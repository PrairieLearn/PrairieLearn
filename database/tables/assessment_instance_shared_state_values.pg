columns
    assessment_instance_id: bigint not null
    data: jsonb not null default '{}'::jsonb
    id: bigint not null default nextval('assessment_instance_shared_state_values_id_seq'::regclass)
    revision_id: bigint not null
    shared_state_object_id: bigint not null
    updated_at: timestamp with time zone not null default now()
    write_seq: integer not null default 0

indexes
    assessment_instance_shared_state_values_pkey: PRIMARY KEY (id) USING btree (id)
    assessment_instance_shared_state_values_ai_id_object_id_key: UNIQUE USING btree (assessment_instance_id, shared_state_object_id)

foreign-key constraints
    assessment_instance_shared_state_va_assessment_instance_id_fkey: FOREIGN KEY (assessment_instance_id) REFERENCES assessment_instances(id) ON UPDATE CASCADE ON DELETE CASCADE
    assessment_instance_shared_state_va_shared_state_object_id_fkey: FOREIGN KEY (shared_state_object_id) REFERENCES shared_state_objects(id) ON UPDATE CASCADE ON DELETE CASCADE
    assessment_instance_shared_state_values_revision_id_fkey: FOREIGN KEY (revision_id) REFERENCES shared_state_object_revisions(id) ON UPDATE CASCADE ON DELETE CASCADE
