columns
    client_id: uuid not null
    is_cleared: boolean not null default false
    raw_submitted_answer: jsonb not null
    revision: bigint not null
    updated_at: timestamp with time zone not null default now()
    user_id: bigint not null
    variant_id: bigint not null

indexes
    submission_drafts_pkey: PRIMARY KEY (variant_id, user_id) USING btree (variant_id, user_id)

foreign-key constraints
    submission_drafts_user_id_fkey: FOREIGN KEY (user_id) REFERENCES users(id) ON UPDATE CASCADE ON DELETE CASCADE
    submission_drafts_variant_id_fkey: FOREIGN KEY (variant_id) REFERENCES variants(id) ON UPDATE CASCADE ON DELETE CASCADE
