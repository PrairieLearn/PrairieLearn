columns
    conversation_id: bigint not null
    created_at: timestamp with time zone not null default now()
    decision: boolean
    digest: text not null
    error: text
    id: bigint not null default nextval('course_agent_proposals_id_seq'::regclass)
    operation_id: uuid not null
    outcome: text
    outcome_success: boolean
    payload: jsonb not null
    prepared: boolean not null default false
    published_sha: text
    sync_diagnostics: text
    sync_job_sequence_id: bigint
    sync_validation_failed: boolean not null default false
    synced_sha: text

indexes
    course_agent_proposals_pkey: PRIMARY KEY (id) USING btree (id)
    course_agent_proposals_operation_id_key: UNIQUE (operation_id) USING btree (operation_id)
    course_agent_proposals_pending_idx: UNIQUE USING btree (conversation_id) WHERE outcome IS NULL

check constraints
    course_agent_proposals_check: CHECK ((outcome IS NULL) = (outcome_success IS NULL))
    course_agent_proposals_check1: CHECK (published_sha IS NULL OR decision IS TRUE)

foreign-key constraints
    course_agent_proposals_conversation_id_fkey: FOREIGN KEY (conversation_id) REFERENCES course_agent_conversations(id) ON UPDATE CASCADE ON DELETE CASCADE
    course_agent_proposals_sync_job_sequence_id_fkey: FOREIGN KEY (sync_job_sequence_id) REFERENCES job_sequences(id) ON UPDATE CASCADE ON DELETE SET NULL
