columns
    center_course_id: bigint not null
    exam_id: bigint not null
    id: bigint not null default nextval('pt_center_exams_id_seq'::regclass)

indexes
    pt_center_exams_pkey: PRIMARY KEY (id) USING btree (id)

foreign-key constraints
    pt_center_exams_center_course_id_fkey: FOREIGN KEY (center_course_id) REFERENCES pt_center_courses(id) ON UPDATE CASCADE ON DELETE CASCADE
    pt_center_exams_exam_id_fkey: FOREIGN KEY (exam_id) REFERENCES pt_exams(id) ON UPDATE CASCADE ON DELETE CASCADE
