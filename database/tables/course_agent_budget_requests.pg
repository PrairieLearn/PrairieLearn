columns
    conversation_id: bigint not null
    created_at: timestamp with time zone not null default now()
    granted_milli_dollars: bigint not null
    http_status: integer not null
    id: bigint not null default nextval('course_agent_budget_requests_id_seq'::regclass)
    request: jsonb not null
    response: jsonb not null
    sequence: bigint not null
    user_id: bigint not null
    window_start: timestamp with time zone not null

indexes
    course_agent_budget_requests_pkey: PRIMARY KEY (id) USING btree (id)
    course_agent_budget_requests_conversation_id_sequence_key: UNIQUE (conversation_id, sequence) USING btree (conversation_id, sequence)
    course_agent_budget_requests_user_window_idx: USING btree (user_id, window_start) WHERE granted_milli_dollars > 0

check constraints
    course_agent_budget_requests_granted_milli_dollars_check: CHECK (granted_milli_dollars >= 0)
    course_agent_budget_requests_sequence_check: CHECK (sequence > 0)

foreign-key constraints
    course_agent_budget_requests_conversation_id_fkey: FOREIGN KEY (conversation_id) REFERENCES course_agent_conversations(id) ON UPDATE CASCADE ON DELETE CASCADE
    course_agent_budget_requests_user_id_fkey: FOREIGN KEY (user_id) REFERENCES users(id) ON UPDATE CASCADE ON DELETE CASCADE
