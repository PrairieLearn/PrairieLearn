columns
    completed_at: timestamp with time zone
    created_at: timestamp with time zone not null default now()
    estimated_cost_milli_dollars: double precision
    id: uuid not null
    model: text not null
    provider: text not null
    provider_cost_milli_dollars: double precision
    run_id: uuid not null
    usage: jsonb

indexes
    course_agent_usage_receipts_pkey: PRIMARY KEY (id) USING btree (id)
    course_agent_usage_receipts_run_id_idx: USING btree (run_id)

foreign-key constraints
    course_agent_usage_receipts_run_id_fkey: FOREIGN KEY (run_id) REFERENCES course_agent_runs(id) ON UPDATE CASCADE ON DELETE CASCADE
