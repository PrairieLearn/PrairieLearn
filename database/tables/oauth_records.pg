columns
    consumed_at: timestamp with time zone
    expires_at: timestamp with time zone
    grant_id: text
    id: text not null
    model: text not null
    payload: jsonb not null
    uid: text
    user_id: bigint

indexes
    oauth_records_pkey: PRIMARY KEY (model, id) USING btree (model, id)
    oauth_records_grant_id_idx: USING btree (grant_id)
    oauth_records_uid_idx: USING btree (uid)
    oauth_records_user_id_idx: USING btree (user_id)

foreign-key constraints
    oauth_records_user_id_fkey: FOREIGN KEY (user_id) REFERENCES users(id) ON UPDATE CASCADE ON DELETE CASCADE
