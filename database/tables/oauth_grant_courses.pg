columns
    course_id: bigint not null
    oauth_grant_id: bigint not null

indexes
    oauth_grant_courses_pkey: PRIMARY KEY (oauth_grant_id, course_id) USING btree (oauth_grant_id, course_id)
    oauth_grant_courses_course_id_idx: USING btree (course_id)

foreign-key constraints
    oauth_grant_courses_course_id_fkey: FOREIGN KEY (course_id) REFERENCES courses(id) ON UPDATE CASCADE ON DELETE CASCADE
    oauth_grant_courses_oauth_grant_id_fkey: FOREIGN KEY (oauth_grant_id) REFERENCES oauth_grants(id) ON UPDATE CASCADE ON DELETE CASCADE
