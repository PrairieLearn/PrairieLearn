columns
    assessment_question_id: bigint not null
    id: bigint not null default nextval('print_form_questions_id_seq'::regclass)
    max_points: double precision not null
    position: integer not null
    print_form_id: bigint not null
    question_number: text not null
    variant_id: bigint not null

indexes
    print_form_questions_pkey: PRIMARY KEY (id) USING btree (id)
    print_form_questions_print_form_id_assessment_question_id_key: UNIQUE (print_form_id, assessment_question_id) USING btree (print_form_id, assessment_question_id)
    print_form_questions_print_form_id_position_key: UNIQUE (print_form_id, "position") USING btree (print_form_id, "position")
    print_form_questions_variant_id_key: UNIQUE (variant_id) USING btree (variant_id)

foreign-key constraints
    print_form_questions_assessment_question_id_fkey: FOREIGN KEY (assessment_question_id) REFERENCES assessment_questions(id) ON UPDATE CASCADE ON DELETE CASCADE
    print_form_questions_print_form_id_fkey: FOREIGN KEY (print_form_id) REFERENCES print_forms(id) ON UPDATE CASCADE ON DELETE CASCADE
    print_form_questions_variant_id_fkey: FOREIGN KEY (variant_id) REFERENCES variants(id) ON UPDATE CASCADE
