columns
    credit: integer
    id: bigint not null default nextval('unsaved_submissions_id_seq'::regclass)
    instance_question_id: bigint not null
    raw_submitted_answer: jsonb not null
    updated_at: timestamp with time zone not null default CURRENT_TIMESTAMP
    user_id: bigint not null
    uuid: uuid not null
    variant_id: bigint not null

indexes
    unsaved_submissions_pkey: PRIMARY KEY (id) USING btree (id)
    unsaved_submissions_instance_question_id_user_id_key: UNIQUE (instance_question_id, user_id) USING btree (instance_question_id, user_id)
    unsaved_submissions_user_id_idx: USING btree (user_id)
    unsaved_submissions_variant_id_idx: USING btree (variant_id)

foreign-key constraints
    unsaved_submissions_instance_question_id_fkey: FOREIGN KEY (instance_question_id) REFERENCES instance_questions(id) ON UPDATE CASCADE ON DELETE CASCADE
    unsaved_submissions_user_id_fkey: FOREIGN KEY (user_id) REFERENCES users(id) ON UPDATE CASCADE ON DELETE CASCADE
    unsaved_submissions_variant_id_fkey: FOREIGN KEY (variant_id) REFERENCES variants(id) ON UPDATE CASCADE ON DELETE CASCADE
