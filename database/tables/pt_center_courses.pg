columns
    center_id: bigint not null
    course_id: bigint not null
    id: bigint not null default nextval('pt_center_courses_id_seq'::regclass)

indexes
    pt_center_courses_pkey: PRIMARY KEY (id) USING btree (id)

foreign-key constraints
    pt_center_courses_center_id_fkey: FOREIGN KEY (center_id) REFERENCES pt_centers(id) ON UPDATE CASCADE ON DELETE CASCADE
    pt_center_courses_course_id_fkey: FOREIGN KEY (course_id) REFERENCES pt_courses(id) ON UPDATE CASCADE ON DELETE CASCADE

referenced by
    pt_center_exams: FOREIGN KEY (center_course_id) REFERENCES pt_center_courses(id) ON UPDATE CASCADE ON DELETE CASCADE
