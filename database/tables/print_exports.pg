columns
    assessment_id: bigint not null
    attempts: integer not null default 0
    authn_user_id: bigint not null
    created_at: timestamp with time zone not null default CURRENT_TIMESTAMP
    failure_message: text
    filename: text not null
    finished_at: timestamp with time zone
    format: text not null
    id: bigint not null default nextval('print_exports_id_seq'::regclass)
    input_key: text not null
    label: text
    output_key: text
    size_bytes: integer
    status: text not null default 'pending'::text
    user_id: bigint not null

indexes
    print_exports_pkey: PRIMARY KEY (id) USING btree (id)
    print_exports_pending_idx: USING btree (id) WHERE status = 'pending'::text

check constraints
    print_exports_format_check: CHECK (format = ANY (ARRAY['pdf'::text, 'docx'::text]))
    print_exports_output_key_matches_status: CHECK ((status = 'succeeded'::text) = (output_key IS NOT NULL))
    print_exports_status_check: CHECK (status = ANY (ARRAY['pending'::text, 'succeeded'::text, 'failed'::text]))

foreign-key constraints
    print_exports_assessment_id_fkey: FOREIGN KEY (assessment_id) REFERENCES assessments(id) ON UPDATE CASCADE ON DELETE CASCADE
    print_exports_authn_user_id_fkey: FOREIGN KEY (authn_user_id) REFERENCES users(id) ON UPDATE CASCADE ON DELETE CASCADE
    print_exports_user_id_fkey: FOREIGN KEY (user_id) REFERENCES users(id) ON UPDATE CASCADE ON DELETE CASCADE
