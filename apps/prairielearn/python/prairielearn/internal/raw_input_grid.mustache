<div class="table-responsive">
  <table class="table table-sm table-bordered mb-0">
    <tbody>
      {{#rows}}
        <tr>
          {{#cells}}
            <td><code style="white-space: pre-wrap; overflow-wrap: anywhere">{{value}}</code></td>
          {{/cells}}
        </tr>
      {{/rows}}
    </tbody>
  </table>
</div>
