{{! htmlmustache-disable pl-prefer-pl-inputs }}
<div class="pl-big-operator-input__direction-input">
  <label class="visually-hidden" for="{{ name }}">Limit direction</label>
  <select
    class="form-select form-select-sm{{#invalid}} is-invalid{{/invalid}}"
    id="{{ name }}"
    name="{{ name }}"
    aria-label="Limit direction"
  >
    <option value="">?</option>
    {{#options}}
      <option value="{{ value }}" {{#selected}} selected{{/selected}}>{{ label }}</option>
    {{/options}}
  </select>
  {{#feedback}}<span class="invalid-feedback d-block">{{ feedback }}</span>{{/feedback}}
  {{#score_badge}}
    <span class="pl-big-operator-input__direction-score">
      {{#correct}}
        <span class="badge text-bg-success" aria-label="Correct">
          <i class="fas fa-check" aria-hidden="true"></i>
        </span>
      {{/correct}}
      {{#incorrect}}
        <span class="badge text-bg-danger" aria-label="Incorrect">
          <i class="fas fa-times" aria-hidden="true"></i>
        </span>
      {{/incorrect}}
    </span>
  {{/score_badge}}
</div>
