{{#prefix_latex}}
  <span class="pl-big-operator-input__affix pl-big-operator-input__affix--prefix">
    \({ \displaystyle {{{prefix_latex}}} }\)
  </span>
{{/prefix_latex}}
{{#integral}}
  <span
    class="pl-big-operator-input__operator-stack pl-big-operator-input__operator-stack--integral"
  >
    <span class="pl-big-operator-input__operator">\(\displaystyle {{{operator_latex}}}\)</span>
    <span class="pl-big-operator-input__limits">
      {{#bounds}}
        <span class="pl-big-operator-input__lower">{{#lower_field}}{{{html}}}{{/lower_field}}</span>
        <span class="pl-big-operator-input__upper">{{#upper_field}}{{{html}}}{{/upper_field}}</span>
      {{/bounds}}
      {{#domain}}
        <span class="pl-big-operator-input__domain-spacer" aria-hidden="true"></span>
        <span class="pl-big-operator-input__lower pl-big-operator-input__annotation">
          {{#annotation_field}}{{{html}}}{{/annotation_field}}
        </span>
      {{/domain}}
    </span>
  </span>
{{/integral}}
{{^integral}}
  <span
    class="pl-big-operator-input__operator-stack{{#bounds}} pl-big-operator-input__operator-stack--bounds{{/bounds}}{{#domain}} pl-big-operator-input__operator-stack--annotated{{/domain}}{{#approaches}} pl-big-operator-input__operator-stack--annotated{{/approaches}}"
  >
    <span class="pl-big-operator-input__operator">\(\displaystyle {{{operator_latex}}}\)</span>
    {{#bounds}}
      <span class="pl-big-operator-input__lower">{{#lower_field}}{{{html}}}{{/lower_field}}</span>
    {{/bounds}}
    {{#domain}}
      <span class="pl-big-operator-input__annotation">
        {{#annotation_field}}{{{html}}}{{/annotation_field}}
      </span>
    {{/domain}}
    {{#approaches}}
      <span class="pl-big-operator-input__annotation">
        {{#annotation_field}}{{{html}}}{{/annotation_field}}
        {{#direction_input}}
          <span class="pl-big-operator-input__direction-input">
            <label class="visually-hidden" for="{{name}}">Limit direction</label>
            <select
              class="form-select form-select-sm{{#invalid}} is-invalid{{/invalid}}"
              id="{{name}}"
              name="{{name}}"
            >
              <option value="">?</option>
              {{#options}}
                <option value="{{value}}" {{#selected}} selected{{/selected}}>{{label}}</option>
              {{/options}}
            </select>
            {{#feedback}}<span class="invalid-feedback d-block">{{feedback}}</span>{{/feedback}}
            {{#score_badge}}
              <span class="pl-big-operator-input__direction-score">
                {{#correct}}
                  <span class="badge text-bg-success" aria-label="Correct">
                    <i class="fas fa-check" aria-hidden="true"></i>
                  </span>
                {{/correct}}
                {{#incorrect}}
                  <span class="badge text-bg-danger" aria-label="Incorrect">
                    <i class="fas fa-times" aria-hidden="true"></i>
                  </span>
                {{/incorrect}}
              </span>
            {{/score_badge}}
          </span>
        {{/direction_input}}
      </span>
    {{/approaches}}
    {{#bounds}}
      <span class="pl-big-operator-input__upper pl-big-operator-input__range-upper-bound">
        {{#upper_field}}{{{html}}}{{/upper_field}}
      </span>
    {{/bounds}}
  </span>
{{/integral}}
{{#body_field}}
  <span class="pl-big-operator-input__body">
    <span class="visually-hidden">{{label}}</span>{{{html}}}
  </span>
{{/body_field}}
{{#integral}}
  <span class="pl-big-operator-input__integral-tail">
    \(\displaystyle \mathrm d {{{index_label}}}{{#suffix_latex}} { {{{suffix_latex}}} }{{/suffix_latex}}\)
  </span>
{{/integral}}
{{^integral}}
  {{#suffix_latex}}
    <span class="pl-big-operator-input__affix pl-big-operator-input__affix--suffix">
      \(\displaystyle {{{suffix_latex}}}\)
    </span>
  {{/suffix_latex}}
{{/integral}}
{{#score_badge}}
  <span class="pl-big-operator-input__submission-score">{{>score-badge}}</span>
{{/score_badge}}
