<div class="pl-spreadsheet card mb-3">
  <div class="card-header">{{aria_label}}</div>
  {{#format_errors}}
    <div class="alert alert-danger m-3" role="alert">{{.}}</div>
  {{/format_errors}}

  {{#editable}}
    <input
      type="hidden"
      name="{{answer_name}}"
      value="{{initial_submission}}"
      data-deferred-initial-value="true"
      class="js-pl-spreadsheet-input"
    />
    <div
      class="pl-spreadsheet-root"
      data-options="{{options}}"
      style="height: {{height}}"
    >
      <div class="alert alert-secondary m-3" role="status">Loading spreadsheet…</div>
    </div>
    <noscript>
      <div class="alert alert-danger m-3" role="alert">
        JavaScript is required to edit this spreadsheet.
      </div>
    </noscript>
  {{/editable}}

  {{#read_only}}
    <div class="card-body pl-spreadsheet-read-only">
      {{#sheets}}
        <section class="mb-4" aria-label="Sheet {{name}}">
          <div class="table-responsive">
            <table class="table table-sm table-bordered mb-0 pl-spreadsheet-table">
              <caption>{{name}}</caption>
              <thead>
                <tr>
                  <th scope="col" aria-label="Row number"></th>
                  {{#columns}}<th scope="col">{{name}}</th>{{/columns}}
                </tr>
              </thead>
              <tbody>
                {{#rows}}
                  <tr>
                    <th scope="row">{{number}}</th>
                    {{#cells}}
                      <td aria-label="Cell {{address}}">
                        <span data-spreadsheet-view="values">{{value}}</span>
                        <span data-spreadsheet-view="formulas" hidden>{{formula}}</span>
                      </td>
                    {{/cells}}
                  </tr>
                {{/rows}}
              </tbody>
            </table>
          </div>
        </section>
      {{/sheets}}
      <div class="d-flex align-items-center justify-content-end gap-2">
        <span>Values</span>
        <div class="form-check form-switch m-0">
          <input
            id="pl-spreadsheet-formula-toggle-{{uuid}}"
            class="form-check-input js-pl-spreadsheet-formula-toggle"
            type="checkbox"
            role="switch"
            aria-label="Show formulas for {{aria_label}}"
          />
        </div>
        <label for="pl-spreadsheet-formula-toggle-{{uuid}}">Formulas</label>
      </div>
    </div>
  {{/read_only}}

  {{#answer}}
    <div class="card-body text-muted">
      This spreadsheet has no built-in correct answer. Its grading is defined by the question.
    </div>
  {{/answer}}
</div>
