{
  "name": "@prairielearn/course-agent",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --port 8790 --persist-to .wrangler/local",
    "generate-types": "wrangler types src/env.d.ts --include-runtime=false --strict-vars=false",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.78",
    "@cloudflare/ai-chat": "0.12.1",
    "@prairielearn/utils": "workspace:^",
    "agents": "0.28.0",
    "ai": "^7.0.116",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260917.1",
    "@prairielearn/tsconfig": "workspace:^",
    "@types/node": "^24.19.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "vitest": "^5.0.2",
    "wrangler": "^4.134.0"
  }
}
