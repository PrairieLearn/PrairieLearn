{
  "name": "@prairielearn/course-agent",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && wrangler deploy --dry-run --outdir dist",
    "check-types": "wrangler types src/env.d.ts --include-runtime=false --strict-vars=false --check",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --port 8790 --persist-to .wrangler/local",
    "generate-protocol": "node scripts/generate-codex-protocol.mjs",
    "generate-types": "wrangler types src/env.d.ts --include-runtime=false --strict-vars=false",
    "test": "vitest run"
  },
  "dependencies": {
    "@cloudflare/ai-chat": "0.12.2",
    "@cloudflare/sandbox": "1.0.3",
    "@prairielearn/course-agent-types": "workspace:^",
    "@sentry/cloudflare": "^11.10.0",
    "agents": "0.32.0",
    "ai": "^7.0.159",
    "hono": "^4.13.14",
    "vscode-jsonrpc": "^9.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261031.1",
    "@openai/codex": "0.166.0",
    "@prairielearn/tsconfig": "workspace:^",
    "@types/node": "^24.19.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "execa": "^10.2.1",
    "prettier": "^3.9.10",
    "ts-morph": "^28.0.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
