{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prairielearn-course-agent",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal", "request_signal_passthrough"],
  "vars": {
    "OPENAI_MODEL": "gpt-5-mini"
  },
  // Secrets (set with `wrangler secret put`, or `.dev.vars` locally):
  // PL_SERVICE_TOKEN, OPENAI_API_KEY.
  "durable_objects": {
    "bindings": [{ "name": "Conversation", "class_name": "Conversation" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Conversation"] }]
}
