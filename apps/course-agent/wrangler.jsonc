{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prairielearn-course-agent",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal", "request_signal_passthrough"],
  "vars": {
    "OPENAI_MODEL": "gpt-6-luna",
    "AGENT_TURN_SECONDS": "21600",
    "USER_IDLE_SECONDS": "600",
    "SENTRY_DSN": "",
    "SENTRY_ENVIRONMENT": "development",
    "PL_SERVICE_URL": "http://localhost:3000"
  },
  "version_metadata": {
    "binding": "VERSION_METADATA"
  },
  "secrets": {
    "required": ["PL_SERVICE_TOKEN", "OPENAI_API_KEY", "GITHUB_READ_TOKEN"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "Conversation",
        "class_name": "Conversation"
      },
      {
        "name": "CourseSandbox",
        "class_name": "CourseSandbox"
      }
    ]
  },
  "exports": {
    "Conversation": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "CourseSandbox": {
      "type": "durable-object",
      "storage": "sqlite",
      "container": "course-agent"
    }
  },
  "containers": [
    {
      "name": "course-agent",
      "scheduling_policy": "durable_object",
      "images": {
        "courseAgent": {
          "dockerfile": "container/Dockerfile",
          "build_context": "."
        }
      }
    }
  ],
  "r2_buckets": [
    {
      "binding": "CHECKPOINTS",
      "bucket_name": "prairielearn-course-agent-checkpoints"
    }
  ],
  "env": {
    "staging": {
      "name": "prairielearn-course-agent-staging",
      "vars": {
        "OPENAI_MODEL": "gpt-6-luna",
        "AGENT_TURN_SECONDS": "21600",
        "USER_IDLE_SECONDS": "600",
        "SENTRY_DSN": "",
        "SENTRY_ENVIRONMENT": "staging",
        "PL_SERVICE_URL": ""
      },
      "secrets": {
        "required": ["PL_SERVICE_TOKEN", "OPENAI_API_KEY", "GITHUB_READ_TOKEN"]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "Conversation",
            "class_name": "Conversation"
          },
          {
            "name": "CourseSandbox",
            "class_name": "CourseSandbox"
          }
        ]
      },
      "r2_buckets": [
        {
          "binding": "CHECKPOINTS",
          "bucket_name": "prairielearn-course-agent-checkpoints-staging"
        }
      ],
      "version_metadata": {
        "binding": "VERSION_METADATA"
      }
    },
    "production": {
      "name": "prairielearn-course-agent-production",
      "vars": {
        "OPENAI_MODEL": "gpt-6-luna",
        "AGENT_TURN_SECONDS": "21600",
        "USER_IDLE_SECONDS": "600",
        "SENTRY_DSN": "",
        "SENTRY_ENVIRONMENT": "production",
        "PL_SERVICE_URL": ""
      },
      "secrets": {
        "required": ["PL_SERVICE_TOKEN", "OPENAI_API_KEY", "GITHUB_READ_TOKEN"]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "Conversation",
            "class_name": "Conversation"
          },
          {
            "name": "CourseSandbox",
            "class_name": "CourseSandbox"
          }
        ]
      },
      "r2_buckets": [
        {
          "binding": "CHECKPOINTS",
          "bucket_name": "prairielearn-course-agent-checkpoints-production"
        }
      ],
      "version_metadata": {
        "binding": "VERSION_METADATA"
      }
    }
  }
}
