{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prairielearn-course-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ANTHROPIC_MODEL": "sonnet",
    "COURSE_AGENT_MAX_BUDGET_USD": "0.25",
    "COURSE_AGENT_IDLE_TIMEOUT_SECONDS": "600",
    "COURSE_AGENT_BACKUP_TTL_SECONDS": "604800",
    "COURSE_AGENT_LOCAL_DEVELOPMENT": "true",
    "COURSE_AGENT_INPUT_MILLIDOLLARS_PER_MILLION": "3000",
    "COURSE_AGENT_CACHE_READ_MILLIDOLLARS_PER_MILLION": "300",
    "COURSE_AGENT_CACHE_WRITE_MILLIDOLLARS_PER_MILLION": "3750",
    "COURSE_AGENT_OUTPUT_MILLIDOLLARS_PER_MILLION": "15000",
    "COURSE_AGENT_REASONING_MILLIDOLLARS_PER_MILLION": "15000",
    "BACKUP_BUCKET_NAME": "prairielearn-course-agent-workspaces"
  },
  "secrets": {
    "required": [
      "ANTHROPIC_API_KEY",
      "COURSE_AGENT_CAPABILITY_SECRET",
      "COURSE_AGENT_GITHUB_PAT",
      "R2_ACCESS_KEY_ID",
      "R2_SECRET_ACCESS_KEY"
    ]
  },
  "r2_buckets": [
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "prairielearn-course-agent-workspaces",
      "preview_bucket_name": "prairielearn-course-agent-workspaces-local"
    }
  ],
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 10
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Sandbox",
        "name": "Sandbox"
      },
      {
        "class_name": "CourseAgentCoordinator",
        "name": "COURSE_AGENT_COORDINATOR"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["Sandbox", "CourseAgentCoordinator"],
      "tag": "v1"
    }
  ]
}
