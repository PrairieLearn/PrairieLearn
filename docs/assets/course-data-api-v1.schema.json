        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d+$",
            "description": "Submission ID."
          },
          "course_instance_id": {
            "type": "string",
            "pattern": "^\\d+$",
            "description": "Course instance."
          },
          "assessment_id": {
            "type": "string",
            "pattern": "^\\d+$",
            "description": "Assessment."
          },
          "assessment_instance_id": {
            "type": "string",
            "pattern": "^\\d+$",
            "description": "Assessment attempt."
          },
          "instance_question_id": {
            "type": "string",
            "pattern": "^\\d+$",
            "description": "Instance question."
          },
          "question_id": {
            "type": "string",
            "pattern": "^\\d+$",
            "description": "Question."
          },
          "variant_id": {
            "type": "string",
            "pattern": "^\\d+$",
            "description": "Variant."
          },
          "user_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d+$",
                "description": "Student; null for team work."
              },
              {
                "type": "null"
              }
            ]
          },
          "team_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d+$",
                "description": "Team; null for individual work."
              },
              {
                "type": "null"
              }
            ]
          },
          "submitted_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                "description": "When the student submitted."
              },
              {
                "type": "null"
              }
            ]
          },
          "mode": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["Public", "Exam", "SEB"]
              },
              {
                "type": "null"
              }
            ],
            "description": "Where it was submitted."
          },
          "gradable": {
            "description": "False when the answer had format errors.",
            "type": ["boolean", "null"]
          },
          "broken": {
            "description": "Whether grading hit an error.",
            "type": ["boolean", "null"]
          },
          "graded_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                "description": "When grading finished; null if not graded."
              },
              {
                "type": "null"
              }
            ]
          },
          "score": {
            "description": "Score from 0 to 1, after any manual override; null if not graded.",
            "type": ["number", "null"]
          },
          "correct": {
            "description": "Whether the submission was fully correct.",
            "type": ["boolean", "null"]
          },
          "overridden": {
            "type": "boolean",
            "description": "Whether staff manually overrode the score."
          },
          "credit": {
            "description": "Credit percentage applied at submission time, such as 100 or 80.",
            "type": ["number", "null"]
          }
        },
        "required": [
          "id",
          "course_instance_id",
          "assessment_id",
          "assessment_instance_id",
          "instance_question_id",
          "question_id",
          "variant_id",
          "user_id",
          "team_id",
          "submitted_at",
          "mode",
          "gradable",
          "broken",
          "graded_at",
          "score",
          "correct",
          "overridden",
          "credit"
        ],
        "additionalProperties": false
      }
    }
  }
}
