{
  "version": 1,
  "query": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "filters": {
        "description": "Conditions that every row must meet, such as assessment_id eq \"12\".",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "column": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "enum": ["eq", "lt", "lte", "gt", "gte"]
            },
            "value": {
              "type": ["string", "number", "boolean"]
            }
          },
          "required": ["column", "op", "value"],
          "additionalProperties": false
        }
      },
      "select": {
        "description": "Columns to include. Omit for all columns.",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "order": {
        "description": "Sort order, most significant first.",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "column": {
              "type": "string"
            },
            "direction": {
              "type": "string",
              "enum": ["asc", "desc"]
            }
          },
          "required": ["column", "direction"],
          "additionalProperties": false
        }
      },
      "limit": {
        "description": "Maximum number of rows.",
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      }
    },
    "additionalProperties": false
  },
  "datasets": {
    "course_instances": {
      "description": "Course instances: offerings of the course, such as a semester.",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "short_name": {
            "type": "string",
            "description": "Directory name under courseInstances/, such as Fa25."
          },
          "long_name": {
            "description": "Display name, such as \"Fall 2025\".",
            "type": ["string", "null"]
          },
          "display_timezone": {
            "type": "string",
            "description": "IANA timezone for dates in this course instance, such as America/Chicago."
          },
          "publishing_start_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              {
                "type": "null"
              }
            ],
            "description": "When students can first access the course instance."
          },
          "publishing_end_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              {
                "type": "null"
              }
            ],
            "description": "When student access ends."
          }
        },
        "required": [
          "id",
          "short_name",
          "long_name",
          "display_timezone",
          "publishing_start_date",
          "publishing_end_date"
        ],
        "additionalProperties": false
      }
    },
    "assessments": {
      "description": "Assessments, such as homeworks, quizzes, and exams, in each course instance.",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "course_instance_id": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "tid": {
            "description": "Directory name under the course instance's assessments/.",
            "type": ["string", "null"]
          },
          "title": {
            "type": ["string", "null"]
          },
          "label": {
            "type": "string",
            "description": "Short label shown to students, such as HW3 or Q4."
          },
          "set_name": {
            "description": "Assessment set name, such as Homework or Quiz.",
            "type": ["string", "null"]
          },
          "number": {
            "type": "string",
            "description": "Number within the assessment set."
          },
          "type": {
            "type": "string",
            "enum": ["Homework", "Exam", "RetryExam", "Basic", "Game"]
          },
          "max_points": {
            "description": "Points needed for a score of 100%.",
            "type": ["number", "null"]
          },
          "max_bonus_points": {
            "description": "Points available beyond 100%.",
            "type": ["number", "null"]
          },
          "multiple_instance": {
            "type": "boolean",
            "description": "Whether a student can start more than one attempt."
          },
          "team_work": {
            "type": "boolean",
            "description": "Whether students work in teams."
          }
        },
        "required": [
          "id",
          "course_instance_id",
          "tid",
          "title",
          "label",
          "set_name",
          "number",
          "type",
          "max_points",
          "max_bonus_points",
          "multiple_instance",
          "team_work"
        ],
        "additionalProperties": false
      }
    },
    "questions": {
      "description": "Questions in the course question bank.",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "qid": {
            "description": "Directory path under questions/.",
            "type": ["string", "null"]
          },
          "title": {
            "type": ["string", "null"]
          },
          "topic": {
            "type": ["string", "null"]
          },
          "grading_method": {
            "type": "string",
            "enum": ["Internal", "External", "Manual", "AI"]
          },
          "single_variant": {
            "description": "Whether every student sees the same variant.",
            "type": ["boolean", "null"]
          },
          "draft": {
            "type": "boolean"
          }
        },
        "required": ["id", "qid", "title", "topic", "grading_method", "single_variant", "draft"],
        "additionalProperties": false
      }
    },
    "assessment_questions": {
      "description": "Questions as placed on an assessment, with their points and statistics. Statistics are precomputed and can be out of date.",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "course_instance_id": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "assessment_id": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "question_id": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "number": {
            "description": "Position on the assessment.",
            "type": ["number", "null"]
          },
          "max_points": {
            "description": "Points available for this question.",
            "type": ["number", "null"]
          },
          "max_auto_points": {
            "description": "Points available from automatic grading.",
            "type": ["number", "null"]
          },
          "max_manual_points": {
            "description": "Points available from manual grading.",
            "type": ["number", "null"]
          },
          "mean_question_score": {
            "description": "Mean score across students, from 0 to 100.",
            "type": ["number", "null"]
          },
          "discrimination": {
            "description": "Correlation between this score and the assessment score, from 0 to 100.",
            "type": ["number", "null"]
          },
          "average_number_submissions": {
            "description": "Mean number of submissions per student.",
            "type": ["number", "null"]
          }
        },
        "required": [
          "id",
          "course_instance_id",
          "assessment_id",
          "question_id",
          "number",
          "max_points",
          "max_auto_points",
          "max_manual_points",
          "mean_question_score",
          "discrimination",
          "average_number_submissions"
        ],
        "additionalProperties": false
      }
    },
    "assessment_instances": {
      "description": "Students' or teams' attempts at assessments, with totals. An assessment with multiple_instance can have several attempts per student.",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "course_instance_id": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "assessment_id": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "user_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d+$"
              },
              {
                "type": "null"
              }
            ],
            "description": "Null for team work."
          },
          "team_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d+$"
              },
              {
                "type": "null"
              }
            ],
            "description": "Null for individual work."
          },
          "number": {
            "type": "number",
            "description": "Attempt number for this student and assessment, from 1."
          },
          "mode": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["Public", "Exam", "SEB"]
              },
              {
                "type": "null"
              }
            ],
            "description": "Where the attempt was taken."
          },
          "open": {
            "type": "boolean",
            "description": "Whether the attempt is still open."
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "closed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "duration": {
            "description": "Time spent on the attempt, in seconds.",
            "type": ["number", "null"]
          },
          "points": {
            "type": ["number", "null"]
          },
          "max_points": {
            "description": "Points needed for a score of 100%.",
            "type": ["number", "null"]
          },
          "score_perc": {
            "description": "Score from 0 to 100, which bonus points can exceed.",
            "type": ["number", "null"]
          },
          "include_in_statistics": {
            "type": "boolean",
            "description": "False for staff attempts and others excluded from assessment statistics."
          }
        },
        "required": [
          "id",
          "course_instance_id",
          "assessment_id",
          "user_id",
          "team_id",
          "number",
          "mode",
          "open",
          "started_at",
          "closed_at",
          "duration",
          "points",
          "max_points",
          "score_perc",
          "include_in_statistics"
        ],
        "additionalProperties": false
      }
    },
    "instance_questions": {
