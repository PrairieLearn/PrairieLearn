{
  "version": 1,
  "query": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "filters": {
        "description": "Conditions that every row must meet.",
        "type": "array",
        "items": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "column": {
                  "type": "string"
                },
                "op": {
                  "type": "string",
                  "enum": ["eq", "lt", "lte", "gt", "gte"]
                },
                "value": {
                  "type": ["string", "number", "boolean"]
                }
              },
              "required": ["column", "op", "value"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "column": {
                  "type": "string"
                },
                "op": {
                  "type": "string",
                  "const": "in"
                },
                "value": {
                  "minItems": 1,
                  "maxItems": 1000,
                  "type": "array",
                  "items": {
                    "type": ["string", "number", "boolean"]
                  }
                }
              },
              "required": ["column", "op", "value"],
              "additionalProperties": false
            }
          ]
        }
      },
      "select": {
        "description": "Columns to include. Omit for all columns.",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "order": {
        "description": "Sort order, most significant first.",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "column": {
              "type": "string"
            },
            "direction": {
              "type": "string",
              "enum": ["asc", "desc"]
            }
          },
          "required": ["column", "direction"],
          "additionalProperties": false
        }
      },
      "limit": {
        "description": "Maximum number of rows.",
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      }
    },
    "additionalProperties": false
  },
  "datasets": {
    "course_instances": {
      "description": "Offerings of the course, each with its own students and assessments.",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "short_name": {
            "type": "string",
            "description": "Short unique identifier for the course instance."
          },
          "long_name": {
            "description": "Long name of the course instance.",
            "type": ["string", "null"]
          },
          "display_timezone": {
            "type": "string",
            "description": "Timezone for all date input and display in the course instance, as an IANA identifier."
          },
          "publishing_start_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              {
                "type": "null"
              }
            ],
            "description": "When students can first access the course instance."
          },
          "publishing_end_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              {
                "type": "null"
              }
            ],
            "description": "When students lose access to the course instance."
          }
        },
        "required": [
          "id",
          "short_name",
          "long_name",
          "display_timezone",
          "publishing_start_date",
          "publishing_end_date"
        ],
        "additionalProperties": false
      }
    },
    "assessments": {
      "description": "Assessments in each course instance.",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "course_instance_id": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "tid": {
            "description": "Short unique identifier for the assessment within its course instance.",
            "type": ["string", "null"]
          },
          "title": {
            "description": "Title of the assessment.",
            "type": ["string", "null"]
          },
          "label": {
            "type": "string",
            "description": "Short label shown to students, made of the assessment set abbreviation and number."
          },
          "set_name": {
            "description": "Name of the assessment set the assessment belongs to.",
            "type": ["string", "null"]
          },
          "number": {
            "type": "string",
            "description": "Number of the assessment within its set."
          },
          "type": {
            "type": "string",
            "enum": ["Exam", "RetryExam", "Basic", "Game", "Homework"],
            "description": "Type of the assessment, which determines how students attempt questions and earn points."
          },
          "max_points": {
            "description": "Points that must be earned to score 100%.",
            "type": ["number", "null"]
          },
          "max_bonus_points": {
            "description": "Additional points that can be earned beyond max_points.",
            "type": ["number", "null"]
          },
          "multiple_instance": {
            "type": "boolean",
            "description": "Whether students can start additional attempts at the assessment."
          },
          "team_work": {
            "type": "boolean",
            "description": "Whether students take the assessment in teams."
          }
        },
        "required": [
          "id",
          "course_instance_id",
          "tid",
          "title",
          "label",
          "set_name",
          "number",
          "type",
          "max_points",
          "max_bonus_points",
          "multiple_instance",
          "team_work"
        ],
        "additionalProperties": false
      }
    },
    "questions": {
      "description": "Questions in the course question bank.",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "qid": {
            "description": "Short unique identifier for the question within the course.",
            "type": ["string", "null"]
          },
          "title": {
            "description": "Title of the question.",
            "type": ["string", "null"]
          },
          "topic": {
            "description": "Category the question belongs to.",
            "type": ["string", "null"]
          },
          "grading_method": {
            "type": "string",
            "enum": ["Internal", "External", "Manual"],
            "description": "How submissions to the question are graded."
          },
          "single_variant": {
            "description": "Whether the question is not randomized and only generates a single variant.",
            "type": ["boolean", "null"]
          },
          "draft": {
            "type": "boolean",
            "description": "Whether the question is an unfinished draft."
          }
        },
        "required": ["id", "qid", "title", "topic", "grading_method", "single_variant", "draft"],
        "additionalProperties": false
      }
    },
    "assessment_questions": {
      "description": "Questions as placed on an assessment, with their points and statistics. Statistics are precomputed and can be out of date.",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "course_instance_id": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "assessment_id": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "question_id": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "number": {
            "description": "Position of the question on the assessment.",
            "type": ["number", "null"]
          },
          "max_points": {
            "description": "Maximum points for the question on the assessment.",
            "type": ["number", "null"]
          },
          "max_auto_points": {
            "description": "Points available from automatic grading.",
            "type": ["number", "null"]
          },
          "max_manual_points": {
            "description": "Points available from manual grading.",
            "type": ["number", "null"]
          },
          "mean_question_score": {
            "description": "Mean score of students on the question, from 0 to 100.",
            "type": ["number", "null"]
          },
          "discrimination": {
            "description": "Correlation between this score and the assessment score, from 0 to 100.",
            "type": ["number", "null"]
          },
          "average_number_submissions": {
            "description": "Mean number of submissions per student.",
            "type": ["number", "null"]
          }
        },
        "required": [
          "id",
          "course_instance_id",
          "assessment_id",
          "question_id",
          "number",
          "max_points",
          "max_auto_points",
          "max_manual_points",
          "mean_question_score",
          "discrimination",
          "average_number_submissions"
        ],
        "additionalProperties": false
      }
    },
    "assessment_instances": {
      "description": "Attempts at assessments by students or teams, with totals. An assessment with multiple_instance can have several attempts per student.",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "course_instance_id": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "assessment_id": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "user_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d+$"
              },
              {
                "type": "null"
              }
            ],
            "description": "Student who owns the attempt. Null for team work."
          },
          "team_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d+$"
              },
              {
                "type": "null"
              }
            ],
            "description": "Team that owns the attempt. Null for individual work."
          },
          "number": {
            "type": "number",
            "description": "Attempt number for this student and assessment, from 1."
          },
          "mode": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["Public", "Exam", "SEB"]
              },
              {
                "type": "null"
              }
            ],
            "description": "Server mode the attempt was started in."
          },
          "open": {
            "type": "boolean",
            "description": "Whether the attempt still accepts answers."
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the attempt started."
          },
          "closed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the attempt closed."
          },
          "duration": {
            "description": "Time spent on the attempt, in seconds.",
            "type": ["number", "null"]
          },
          "points": {
            "description": "Points earned on the attempt.",
            "type": ["number", "null"]
          },
          "max_points": {
            "description": "Points needed for a score of 100%.",
            "type": ["number", "null"]
          },
          "score_perc": {
            "description": "Score from 0 to 100, which bonus points can exceed.",
            "type": ["number", "null"]
          },
          "include_in_statistics": {
            "type": "boolean",
            "description": "False for staff attempts and others excluded from assessment statistics."
          }
        },
        "required": [
          "id",
          "course_instance_id",
          "assessment_id",
          "user_id",
          "team_id",
          "number",
          "mode",
          "open",
          "started_at",
          "closed_at",
          "duration",
          "points",
          "max_points",
          "score_perc",
          "include_in_statistics"
        ],
        "additionalProperties": false
      }
    },
    "instance_questions": {
