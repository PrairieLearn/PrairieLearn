          },
          "status": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "complete",
                  "unanswered",
                  "saved",
                  "correct",
                  "incorrect",
                  "grading",
                  "invalid"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "points": {
            "description": "Points from automatic and manual grading.",
            "type": ["number", "null"]
          },
          "auto_points": {
            "description": "Points from automatic grading.",
            "type": ["number", "null"]
          },
          "manual_points": {
            "description": "Points from manual grading.",
            "type": ["number", "null"]
          },
          "score_perc": {
            "description": "Score from 0 to 100.",
            "type": ["number", "null"]
          },
          "number_attempts": {
