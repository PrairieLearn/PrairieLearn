              },
              {
                "type": "null"
              }
            ],
            "description": "When the question was added to the attempt."
          }
        },
        "required": [
          "id",
          "course_instance_id",
          "assessment_id",
          "assessment_instance_id",
          "assessment_question_id",
          "question_id",
          "number",
          "status",
          "points",
          "auto_points",
          "manual_points",
          "score_perc",
          "number_attempts",
          "highest_submission_score",
          "requires_manual_grading",
          "duration",
          "created_at"
        ],
        "additionalProperties": false
      }
    },
