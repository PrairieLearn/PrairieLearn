          "assessment_id": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "assessment_instance_id": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "assessment_question_id": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "question_id": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "number": {
            "description": "Position in the attempt.",
